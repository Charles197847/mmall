generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String?   @unique
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  role            Role      @default(CUSTOMER)
  passwordHash    String    @map("password_hash")
  deliveryAddress Json?     @map("delivery_address")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  vendorProfile Vendor?
  orders        Order[]
  reviews       Review[]
  deviceTokens  DeviceToken[]
  notifications Notification[]
  passkeys      PasskeyCredential[]

  @@map("users")
}

model Vendor {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  storeName        String   @unique @map("store_name")
  slug             String   @unique
  description      String?
  logo             String?
  coverImage       String?  @map("cover_image")
  isActive         Boolean  @default(false) @map("is_active")
  isApproved       Boolean  @default(false) @map("is_approved")
  commissionRate         Float    @default(10.0) @map("commission_rate")
  stripeAccountId        String?  @map("stripe_account_id")
  paygateBeneficiaryId   String?  @map("paygate_beneficiary_id")
  settings               Json?
  city                   String?
  province               String?
  postalCode             String?  @map("postal_code")
  lat                    Float?
  lng                    Float?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  orderItems   OrderItem[]
  vendorOrders VendorOrder[]
  generationUsages GenerationUsage[]
  generationJobs   GenerationJob[]
  adCampaigns      AdCampaign[]
  kyc              VendorKyc?

  @@map("vendors")
}

model Product {
  id           String   @id @default(cuid())
  vendorId     String   @map("vendor_id")
  name         String
  slug         String   @unique
  description  String
  price        Float
  comparePrice Float?   @map("compare_price")
  costPerItem  Float?   @map("cost_per_item")
  inventory    Int      @default(0)
  sku          String?
  images       String[]
  category     String?
  tags         String[]
  isActive     Boolean  @default(true) @map("is_active")
  isDigital    Boolean  @default(false) @map("is_digital")
  weight       Float?
  dimensions   Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  reviews    Review[]

  @@index([vendorId])
  @@index([category])
  @@map("products")
}

model Order {
  id              String        @id @default(cuid())
  customerId      String        @map("customer_id")
  status          OrderStatus   @default(PENDING)
  totalAmount     Float         @map("total_amount")
  subtotal        Float
  tax             Float         @default(0)
  shippingTotal   Float         @default(0) @map("shipping_total")
  discountTotal   Float         @default(0) @map("discount_total")
  paymentIntentId      String?       @map("payment_intent_id")
  payRequestId         String?       @unique @map("pay_request_id")
  paygateTransactionId String?       @map("paygate_transaction_id")
  paymentMethod        String?       @map("payment_method")
  paymentStatus        PaymentStatus @default(PENDING) @map("payment_status")
  shippingAddress Json          @map("shipping_address")
  billingAddress  Json?         @map("billing_address")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer     User          @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  vendorOrders VendorOrder[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String @map("order_id")
  vendorId    String @map("vendor_id")
  productId   String @map("product_id")
  quantity    Int
  price       Float
  total       Float
  variantData Json?  @map("variant_data")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@map("order_items")
}

model VendorOrder {
  id              String            @id @default(cuid())
  orderId         String            @map("order_id")
  vendorId        String            @map("vendor_id")
  status          VendorOrderStatus @default(PENDING)
  subtotal        Float
  commission      Float
  gatewayFee      Float             @default(0) @map("gateway_fee")
  feeBreakdown    Json?             @map("fee_breakdown")
  payoutAmount    Float             @map("payout_amount")
  shippingCarrier String?           @map("shipping_carrier")
  trackingNumber  String?           @map("tracking_number")
  shippedAt       DateTime?         @map("shipped_at")
  deliveredAt     DateTime?         @map("delivered_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor    Vendor     @relation(fields: [vendorId], references: [id])
  shipments Shipment[]

  @@index([orderId])
  @@index([vendorId])
  @@map("vendor_orders")
}

model Review {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  customerId String   @map("customer_id")
  rating     Int      @default(5)
  title      String?
  content    String
  images     String[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id])

  @@index([productId])
  @@map("reviews")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VendorOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  BOOKED
  COLLECTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

model Shipment {
  id                String         @id @default(cuid())
  vendorOrderId     String         @map("vendor_order_id")
  carrier           String         @default("THE_COURIER_GUY")
  serviceLevelCode  String         @map("service_level_code")
  serviceName       String         @map("service_name")
  trackingNumber    String         @unique @map("tracking_number")
  amount            Float
  currency          String         @default("ZAR")
  status            ShipmentStatus @default(BOOKED)
  collectionAddress Json           @map("collection_address")
  deliveryAddress   Json           @map("delivery_address")
  estimatedDays     Int            @map("estimated_days")
  events            Json
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
  @@map("shipments")
}

enum GenerationAssetType {
  LOGO
  BANNER
}

enum AdSlot {
  HOMEPAGE_BANNER
  SEARCH_FEATURE
  SHOP_HIGHLIGHT
  PUSH_BLAST
}

enum AdCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum AdEventType {
  IMPRESSION
  CLICK
}

model GenerationUsage {
  id          String               @id @default(cuid())
  vendorId    String               @map("vendor_id")
  assetType   GenerationAssetType  @map("asset_type")
  freeUsed    Int                  @default(0) @map("free_used")
  paidCredits Int                  @default(0) @map("paid_credits")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, assetType])
  @@map("generation_usages")
}

model GenerationJob {
  id        String              @id @default(cuid())
  vendorId  String              @map("vendor_id")
  assetType GenerationAssetType @map("asset_type")
  prompt    String
  imageUrl  String              @map("image_url")
  provider  String
  billedAs  String              @map("billed_as")
  createdAt DateTime            @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("generation_jobs")
}

model AdCampaign {
  id           String            @id @default(cuid())
  vendorId     String            @map("vendor_id")
  slot         AdSlot
  title        String
  headline     String?
  imageUrl     String?           @map("image_url")
  linkUrl      String?           @map("link_url")
  status       AdCampaignStatus  @default(DRAFT)
  startsAt     DateTime          @map("starts_at")
  endsAt       DateTime          @map("ends_at")
  price        Float
  impressions  Int               @default(0)
  clicks       Int               @default(0)
  audienceSize Int?              @map("audience_size")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  vendor Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  events AdEvent[]

  @@index([slot, status])
  @@index([vendorId])
  @@map("ad_campaigns")
}

model AdEvent {
  id         String      @id @default(cuid())
  campaignId String      @map("campaign_id")
  type       AdEventType
  createdAt  DateTime    @default(now()) @map("created_at")

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
  @@map("ad_events")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  token     String   @unique
  platform  String   @default("web")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  title     String
  body      String
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notifications")
}

enum KycTier {
  EXPLORER
  ACTIVE_VENDOR
  ENTERPRISE
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum IdentityType {
  SA_ID_CARD
  SA_GREEN_BOOK
  PASSPORT
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("phone_otps")
}

model VendorKyc {
  id                  String        @id @default(cuid())
  vendorId            String        @unique @map("vendor_id")
  approvedTier        KycTier       @default(EXPLORER) @map("approved_tier")
  requestedTier       KycTier       @default(ACTIVE_VENDOR) @map("requested_tier")
  status              KycStatus     @default(NOT_STARTED)
  identityType        IdentityType? @map("identity_type")
  legalName           String?       @map("legal_name")
  idNumber            String?       @map("id_number")
  residentialAddress  String?       @map("residential_address")
  idDocumentName      String?       @map("id_document_name")
  addressDocumentName String?       @map("address_document_name")
  selfieCaptured      Boolean       @default(false) @map("selfie_captured")
  cipcDocumentName    String?       @map("cipc_document_name")
  taxNumber           String?       @map("tax_number")
  vatNumber           String?       @map("vat_number")
  bankProofName       String?       @map("bank_proof_name")
  rejectionReason     String?       @map("rejection_reason")
  reviewEtaMinutes    Int           @default(30) @map("review_eta_minutes")
  provider            String        @default("smileid")
  providerRef         String?       @map("provider_ref")
  submittedAt         DateTime?     @map("submitted_at")
  reviewedAt          DateTime?     @map("reviewed_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_kyc")
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  deviceType   String   @default("singleDevice") @map("device_type")
  backedUp     Boolean  @default(false) @map("backed_up")
  transports   String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}
