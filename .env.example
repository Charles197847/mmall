# =============================================================================
# MMall — environment template
# Copy to .env (repo root) and backend/.env for local development
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL 16+)
# Local docker. Hosted Supabase uses two URLs — see docs/DEPLOY.md.
# DATABASE_URL is the runtime connection (session pooler on Supabase).
# DIRECT_URL is used by Prisma Migrate. Locally both point at the same database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shopping_mall
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/shopping_mall

# Redis (cache + BullMQ). Hosted: Upstash rediss:// URL. Do not use an evicting database.
REDIS_URL=redis://localhost:6379

# Search. Local docker uses Elasticsearch. A hosted demo sets SEARCH_PROVIDER=postgres
# and can leave ELASTICSEARCH_URL empty. elasticsearch | postgres
SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Auth (JWT). Production refuses to boot on this placeholder (MM-QA-032).
# Generate a real value with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=2h
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081,http://localhost:3001,http://localhost:3002

# Demo accounts in prisma/seed.ts use Password123!.
# Leave unset for local docker. Set to true only to seed an intentional demo database,
# then unset it. Refused when NODE_ENV=production or DATABASE_URL is a hosted Postgres.
# ALLOW_DEMO_SEED=true

# Clerk (optional)
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stripe is not used (not available for SA merchants). PayGate PayWeb + PayBatch instead.
# Stay on mock. Live PayGate is not wired; production refuses any other PAYGATE_MODE.
PAYGATE_ID=10011072130
PAYGATE_ENCRYPTION_KEY=secret
PAYGATE_MODE=mock
API_PUBLIC_URL=http://localhost:4000
# PayGate notify is derived: {API_PUBLIC_URL}/api/v1/payments/paygate/notify
# Return URLs are chosen by the checkout client and checked against an allowlist.
# Shop (/shop) uses {VENDOR_DASHBOARD_URL}/shop/checkout/payment-return
#   production: https://mmall.meeronixgroup.co.za/shop/checkout/payment-return
# Expo web uses {FRONTEND_URL}/cart/payment-return
#   production: https://mmall-app.meeronixgroup.co.za/cart/payment-return
# Extra preview returns (full URLs, comma-separated). Not one global return.
# PAYGATE_RETURN_URLS=

# Storage (pick one)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend origins. Production (do not point these at the apex meeronixgroup.co.za):
# FRONTEND_URL=https://mmall-app.meeronixgroup.co.za
# VENDOR_DASHBOARD_URL=https://mmall.meeronixgroup.co.za
# ADMIN_PANEL_URL=https://mmall-admin.meeronixgroup.co.za
# API_PUBLIC_URL=https://mmall-api.meeronixgroup.co.za
# CORS always allows those three https origins. Localhost origins are added only
# outside production, and any localhost value is stripped when NODE_ENV=production.
# Extra origins (Vercel previews) go in CORS_ORIGINS, comma-separated.
FRONTEND_URL=http://localhost:8081
VENDOR_DASHBOARD_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002
# Local only. EAS preview/production and the Expo web export use
# https://mmall-api.meeronixgroup.co.za/api/v1. See docs/MOBILE_RELEASE.md.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Shows "Demo — payments are simulated" on /shop and on the Expo web export.
NEXT_PUBLIC_DEMO_PAYMENTS=true
EXPO_PUBLIC_DEMO_PAYMENTS=true
# CORS_ORIGINS=

# AI image generation (optional — Pollinations is used if none are set)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
RECRAFT_API_KEY=
IDEOGRAM_API_KEY=

# Push notifications (optional — in-app notifications still persist without FCM)
FIREBASE_SERVER_KEY=
FCM_SERVER_KEY=

# KYC / KYB (Smile ID stub locally; set false to require admin review)
KYC_PROVIDER=smileid
KYC_STUB_AUTO_APPROVE=true
