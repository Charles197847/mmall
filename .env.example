# =============================================================================
# MMall — environment template
# Copy to .env (repo root) and backend/.env for local development
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shopping_mall

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Auth (JWT). Optionally swap in Clerk or Supabase Auth later.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=2h
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8081,http://localhost:3001,http://localhost:3002

# Clerk (optional)
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stripe is not used (not available for SA merchants). PayGate PayWeb + PayBatch instead.
PAYGATE_ID=10011072130
PAYGATE_ENCRYPTION_KEY=secret
PAYGATE_MODE=mock
API_PUBLIC_URL=http://localhost:4000

# Storage (pick one)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend
FRONTEND_URL=http://localhost:8081
VENDOR_DASHBOARD_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# AI image generation (optional — Pollinations is used if none are set)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
RECRAFT_API_KEY=
IDEOGRAM_API_KEY=

# Push notifications (optional — in-app notifications still persist without FCM)
FIREBASE_SERVER_KEY=
FCM_SERVER_KEY=

# KYC / KYB (Smile ID stub locally; set false to require admin review)
KYC_PROVIDER=smileid
KYC_STUB_AUTO_APPROVE=true
