# Local shop + vendor desk. Production value is set on the mmall-shop Vercel project.
# Include /api/v1. The host itself is https://mmall-api.meeronixgroup.co.za.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_IMGBB_API_KEY=

# Set to true on the deployed shop so every /shop page, including checkout, shows
# "Demo — payments are simulated".
NEXT_PUBLIC_DEMO_PAYMENTS=true
