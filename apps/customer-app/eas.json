{
  "cli": {
    "version": ">= 16.0.0",
    "requireCommit": false,
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.18.3",
      "pnpm": "10.15.1",
      "corepack": true
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000/api/v1",
        "EXPO_PUBLIC_DEMO_PAYMENTS": "true"
      },
      "ios": {
        "simulator": true,
        "image": "sdk-52"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mmall-api.meeronixgroup.co.za/api/v1",
        "EXPO_PUBLIC_DEMO_PAYMENTS": "true"
      },
      "ios": {
        "simulator": false,
        "image": "sdk-52"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mmall-api.meeronixgroup.co.za/api/v1",
        "EXPO_PUBLIC_DEMO_PAYMENTS": "true"
      },
      "ios": {
        "image": "sdk-52"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha"
      }
    }
  }
}
