# Local Expo. Production / web export value is set on the mmall-app Vercel project.
# Include /api/v1. The host itself is https://mmall-api.meeronixgroup.co.za.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Set to true on the deployed Expo web export so the simulated-payments notice shows.
EXPO_PUBLIC_DEMO_PAYMENTS=true
