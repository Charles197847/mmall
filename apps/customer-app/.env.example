# Local Expo and the EAS development profile. Include /api/v1.
# EAS preview and production set https://mmall-api.meeronixgroup.co.za/api/v1 in eas.json.
# The mmall-app Vercel project sets the same production URL for the web export.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Set to true on the deployed Expo web export so the simulated-payments notice shows.
EXPO_PUBLIC_DEMO_PAYMENTS=true
