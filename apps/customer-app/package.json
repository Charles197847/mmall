{
  "name": "customer-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "eas:android": "eas build --platform android --profile preview",
    "eas:ios": "eas build --platform ios --profile preview",
    "eas:all": "eas build --platform all --profile preview",
    "web": "expo start --web --port 8085",
    "build": "expo export --platform web",
    "lint": "echo \"no lint\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .expo dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@shopping-mall/api-client": "workspace:*",
    "@shopping-mall/shared-types": "workspace:*",
    "@shopping-mall/shared-ui": "workspace:*",
    "@tamagui/config": "^1.125.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~52.0.46",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.21",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "nativewind": "4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "tamagui": "^1.125.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@types/react": "~18.3.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
